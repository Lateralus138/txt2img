_txt2img() {
    local cur prev opts
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    opts="-v --version -h --help -t --text -W --width -H --height -T --trim-height -r --raw -n --file-name -o --output-directory --fg --bg --font --font-size --padding --tabsize"

    case "${prev}" in
        -o|--output-directory)
            COMPREPLY=( $(compgen -d -- "${cur}") )
            return 0
            ;;
        --font)
            COMPREPLY=( $(compgen -f -X '!*.[ot]tf' -- "${cur}") )
            return 0
            ;;
        -n|--file-name)
            # Default to filename completion
            COMPREPLY=( $(compgen -f -- "${cur}") )
            return 0
            ;;
        -t|--text|-W|--width|-H|--height|--fg|--bg|--font-size|--padding|--tabsize)
            # These expect specific values (text, numbers, colors), no specific completion
            return 0
            ;;
    esac

    if [[ ${cur} == -* ]] ; then
        COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
        return 0
    fi

    # Fallback to file completion for the non-switch argument (input file)
    COMPREPLY=( $(compgen -f -- "${cur}") )
}

complete -F _txt2img txt2img
